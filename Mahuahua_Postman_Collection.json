			"item": [
				{
					"name": "➕ Crear Paciente",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nombre\": \"Juan\",\n    \"apellidos\": \"Perez\",\n    \"email\": \"juan.perez@example.com\",\n    \"telefono\": \"+573001234567\",\n    \"fechaNacimiento\": \"1990-05-15\"\n}"
						},
						"url": {"raw": "{{base_url}}/api/pacientes", "host": ["{{base_url}}"], "path": ["api", "pacientes"]}
					}
				},
				{
					"name": "👁️ Obtener Todos los Pacientes",
					"request": {
						"method": "GET",
						"url": {"raw": "{{base_url}}/api/pacientes", "host": ["{{base_url}}"], "path": ["api", "pacientes"]}
