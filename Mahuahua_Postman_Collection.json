		{
			"name": "📅 3. Citas",
			"item": [
				{
					"name": "➕ Agendar Cita",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"pacienteId\": 1,\n    \"psicologoId\": 1,\n    \"fechaHora\": \"2026-06-01T10:00:00\",\n    \"motivo\": \"Consulta por ansiedad generalizada\"\n}"
						},
						"url": {"raw": "{{base_url}}/api/citas", "host": ["{{base_url}}"], "path": ["api", "citas"]}
					}
				},
				{
					"name": "🔍 Obtener Cita por ID",
					"request": {
						"method": "GET",
						"url": {"raw": "{{base_url}}/api/citas/1", "host": ["{{base_url}}"], "path": ["api", "citas", "1"]}
					}
				},
				{
					"name": "👁️ Obtener Citas por Paciente",
					"request": {
						"method": "GET",
						"url": {"raw": "{{base_url}}/api/citas/paciente/1", "host": ["{{base_url}}"], "path": ["api", "citas", "paciente", "1"]}
					}
				},
				{
					"name": "👁️ Obtener Citas por Psicólogo",
					"request": {
						"method": "GET",
						"url": {"raw": "{{base_url}}/api/citas/psicologo/1", "host": ["{{base_url}}"], "path": ["api", "citas", "psicologo", "1"]}
					}
				},
				{
					"name": "🔄 Cambiar Estado de Cita",
					"request": {
						"method": "PATCH",
						"url": {
							"raw": "{{base_url}}/api/citas/1/estado?estado=CONFIRMADA",
							"host": ["{{base_url}}"],
							"path": ["api", "citas", "1", "estado"],
							"query": [{"key": "estado", "value": "CONFIRMADA", "description": "Opciones: PENDIENTE, CONFIRMADA, COMPLETADA, CANCELADA"}]
						}
					}
				},
				{
					"name": "🗑️ Eliminar Cita",
					"request": {
						"method": "DELETE",
						"url": {"raw": "{{base_url}}/api/citas/1", "host": ["{{base_url}}"], "path": ["api", "citas", "1"]}
